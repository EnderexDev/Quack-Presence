{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "T3 Presence",
  "version": "1.0.0",
  "identifier": "dev.enderex.t3presence",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "T3 Presence",
        "url": "settings.html",
        "width": 480,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d0b08"
      },
      {
        "label": "tray",
        "title": "T3 Presence",
        "url": "tray.html",
        "width": 320,
        "height": 400,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
