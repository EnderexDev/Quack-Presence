{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quack Presence",
  "mainBinaryName": "Quack Presence",
  "version": "1.1.4",
  "identifier": "dev.enderex.quackpresence",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Quack Presence",
        "url": "settings.html",
        "width": 480,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d0b08"
      },
      {
        "label": "tray",
        "title": "Quack Presence",
        "url": "tray.html",
        "width": 320,
        "height": 400,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../presence.mjs": "presence.mjs",
      "../../config.json": "config.default.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3REFGQTFGNkZGQkY3MUIKUldRYjkvdHZIL3JhUnpUdFU3YlZYdDY4T250K0lTOFJicllQcWV2bWxjWjhWRU1rVUkwTk9CQnoK",
      "endpoints": [
        "https://github.com/EnderexDev/Quack-Presence/releases/latest/download/latest.json"
      ]
    }
  }
}
